DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nextstep
DB_SSLMODE=disable
PORT=8080
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# development | production (production = gin release + JWT guard + warning bila DB_SSLMODE=disable)
APP_ENV=development
# kosong = ikut skema FRONTEND_URL (https -> Secure); override true/false bila perlu
COOKIE_SECURE=
# Lax | Strict | None (None selalu dipaksa Secure; butuh https)
COOKIE_SAMESITE=Lax
# kosong = langsung tanpa proxy; isi CIDR/IP proxy (mis. 10.0.0.0/8) bila di belakang reverse proxy
TRUSTED_PROXIES=